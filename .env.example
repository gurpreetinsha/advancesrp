# Neon PostgreSQL connection strings (keep real values in Vercel environment variables)
# DATABASE_URL should use Neon's pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/srgc_srp?sslmode=require"
# For Prisma CLI schema operations, use Neon's direct (non-pooler) connection string.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/srgc_srp?sslmode=require"
# Generate a unique secret with: openssl rand -base64 32
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"
COLLEGE_NAME="Shri Ram Group of Colleges"
COLLEGE_CODE="SRGC"
COLLEGE_ACCREDITATION=""
GRADE_SCALE_NAME="Standard 10-Point Scale"
COLLEGE_LOGO_URL="/images/college-logo.svg"
NEXT_PUBLIC_APP_URL="https://srgc-srp.vercel.app"
NEXT_PUBLIC_COLLEGE_NAME="Shri Ram Group of Colleges"
